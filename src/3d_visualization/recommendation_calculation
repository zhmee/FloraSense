from __future__ import annotations
import numpy as np
import sys
from pathlib import Path

# add src/ to path so we can import from flower_recommender_prototype3.py
sys.path.append(str(Path(__file__).resolve().parent.parent))
from flower_recommender_prototype3 import recommend_flowers, get_flower_vectors


# returns recommended flowers to highlight in the 3D visualization based on the current bouquet
# each recommendation has a score (0-100) that the frontend can use to set connection strength
# selected_scientific_names: list of scientific names the user has selected, passed in by the frontend
def get_bouquet_recommendations(selected_scientific_names: list[str]) -> dict:
    if not selected_scientific_names:
        return {"recommendations": []}

    data = get_flower_vectors(selected_scientific_names)
    selected_flowers = data["flowers"]

    if not selected_flowers:
        return {"recommendations": []}

    selected_names = {f["name"].lower() for f in selected_flowers}

    # --- primary path: meaning-based query ---
    meaning_chunks = []
    for f in selected_flowers:
        for meaning in f["meanings"]:
            for chunk in meaning.split(";"):
                chunk = chunk.strip(" .:")
                if chunk and len(chunk.split()) <= 8:
                    meaning_chunks.append(chunk)

    seen, deduped = set(), []
    for chunk in meaning_chunks:
        key = chunk.lower()
        if key not in seen:
            seen.add(key)
            deduped.append(chunk)

    fetch_limit = max(15, len(selected_flowers) * 3)

    if deduped:
        pseudo_query = " ".join(deduped[:20])
        result = recommend_flowers(pseudo_query, limit=fetch_limit)
        recommendations = [
            s for s in result["suggestions"]
            if s["name"].lower() not in selected_names
        ][:5]

        if recommendations:
            return {"recommendations": recommendations}

    # --- fallback: color-based query ---
    # collect all colors across the bouquet, deduplicated
    all_colors = []
    seen_colors = set()
    for f in selected_flowers:
        for color in f.get("colors", []):
            c = color.lower().strip()
            if c and c not in seen_colors:
                seen_colors.add(c)
                all_colors.append(color)

    if not all_colors:
        return {"recommendations": []}

    color_query = " ".join(all_colors[:10])
    result = recommend_flowers(color_query, limit=fetch_limit)
    recommendations = [
        s for s in result["suggestions"]
        if s["name"].lower() not in selected_names
    ][:5]
    data = get_flower_vectors(["Bird Of Paradise", "Baby's Breath", "Lily"])
    print(data)
    return {"recommendations": recommendations, "fallback": "color"}